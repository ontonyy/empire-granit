{
  "name": "empire-granit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run generate:seo && vite build && vite build --ssr src/ssr/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "optimize:services": "node scripts/optimize-services.mjs",
    "generate:seo": "node scripts/generate-seo-assets.mjs",
    "optimize:monuments": "node scripts/optimize-monuments.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "lint": "tsc --noEmit",
    "lint:links": "node scripts/check-links.mjs",
    "test": "vitest run",
    "optimize:fences": "node scripts/optimize-fences.mjs",
    "optimize:engravings": "node scripts/optimize-engravings.mjs",
    "optimize:environment": "node scripts/optimize-environment.mjs"
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.0.2",
    "sharp": "^0.34.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.5"
  }
}
